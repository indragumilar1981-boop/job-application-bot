{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/search",
      "destination": "/api/index.js"
    },
    {
      "source": "/send-application",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
