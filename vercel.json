{
  "version": 2,
  "rewrites": [
    {
      "source": "/send-application",
      "destination": "/api/send-application.js"
    },
    {
      "source": "/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/linkedin-feed",
      "destination": "/api/linkedin-feed.js"
    },
    {
      "source": "/api/send-application",
      "destination": "/api/send-application.js"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/api/linkedin-feed",
      "destination": "/api/linkedin-feed.js"
    },
    {
      "source": "/api/cron-autopilot",
      "destination": "/api/cron-autopilot.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-autopilot",
      "schedule": "0 */2 * * *"
    }
  ]
}
